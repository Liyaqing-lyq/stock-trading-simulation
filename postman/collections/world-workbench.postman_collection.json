              "const slots=pm.response.json().slots;",
              "pm.test(\"Five masks only\", () => { pm.expect(slots.length).to.equal(5); slots.forEach(s=>{pm.expect(s.masked).to.match(/^\\*{8}.{4}$/); pm.expect(s).not.to.have.property(\"secret\");}); });"
            ]
          }
        }
