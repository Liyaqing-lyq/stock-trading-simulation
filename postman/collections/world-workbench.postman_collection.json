          },
          {
            "key": "X-World-Request",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/api/admin/keys/key-1/reveal",
        "body": {
          "mode": "raw",
          "raw": "{\"confirm\": \"true\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
