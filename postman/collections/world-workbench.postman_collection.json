{
  "info": {
    "name": "World Workbench Local Contract",
    "description": "Run only against a fresh local test world with dummy key values. Uses a one-time local admin bootstrap supplied at runtime. Advances the test world to 1000ms and saves the same non-secret route settings once. No provider calls. Disable remote event reporting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18080"
    },
    {
      "key": "bootstrap",
      "value": ""
    },
    {
      "key": "session_cookie",
      "value": ""
    },
    {
      "key": "old_admin_cookie",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Unauthenticated admin denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/admin/view"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"No cached private data\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "02 Cross origin login denied",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "https://invalid.example"
          },
          {
            "key": "X-World-Request",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/api/session",
        "body": {
          "mode": "raw",
          "raw": "{\"bootstrap\": \"{{bootstrap}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"No cached private data\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "03 Local admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{base_url}}"
          },
          {
            "key": "X-World-Request",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/api/session",
        "body": {
          "mode": "raw",
          "raw": "{\"bootstrap\": \"{{bootstrap}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No cached private data\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "const cookie = pm.response.headers.get(\"Set-Cookie\").split(\";\")[0];",
              "pm.collectionVariables.set(\"session_cookie\", cookie);",
              "pm.collectionVariables.set(\"old_admin_cookie\", cookie);",
              "pm.test(\"HttpOnly session\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"HttpOnly\"));",
              "pm.test(\"Token absent from body\", () => pm.expect(pm.response.json()).to.deep.equal({role:\"ADMIN\"}));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "04 Current admin identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{session_cookie}}"
          }
        ],
        "url": "{{base_url}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No cached private data\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"Bound identity\", () => pm.expect(pm.response.json().role).to.equal(\"ADMIN\"));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "05 Confirmed world snapshot",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{session_cookie}}"
          }
        ],
        "url": "{{base_url}}/api/admin/view"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No cached private data\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "const view=pm.response.json();",
              "pm.collectionVariables.set(\"position\",view.position);",
              "pm.test(\"Exact world numbers\", () => { pm.expect(view.position).to.match(/^[0-9]+$/); pm.expect(view.timeMillis).to.be.a(\"string\"); view.accounts.forEach(a=>pm.expect(a.cash).to.be.a(\"string\")); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "06 Five masked slots",
