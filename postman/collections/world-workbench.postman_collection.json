    {
      "name": "08 Five scene routes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{session_cookie}}"
          }
        ],
        "url": "{{base_url}}/api/admin/routes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No cached private data\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "const config=pm.response.json();",
              "const fields=[\"scene\",\"slotId\",\"model\",\"enabled\",\"maxCalls\",\"maxTotalTokens\",\"maxOutputTokens\",\"maxConcurrency\"];",
              "const routes=config.routes.map(r=>Object.fromEntries(fields.map(f=>[f,r[f]])));",
              "pm.collectionVariables.set(\"route_body\",JSON.stringify({expectedRevision:config.revision,routes}));",
              "pm.test(\"Five scenes and precise revision\",()=>{pm.expect(config.revision).to.be.a(\"string\");pm.expect(routes.length).to.equal(5);pm.expect(config.baseUrl).to.equal(\"https://api.deepseek.com\");});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
